{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "Loading read-skills-first policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_01_skills.php"
                    },
                    {
                        "type": "command",
                        "statusMessage": "Loading model delegation policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_02_delegation.php"
                    },
                    {
                        "type": "command",
                        "statusMessage": "Loading documentation-sync policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_03_docsync.php"
                    },
                    {
                        "type": "command",
                        "statusMessage": "Loading review-action policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_04_review_action.php"
                    },
                    {
                        "type": "command",
                        "statusMessage": "Loading bypass-phrase policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_05_bypass.php"
                    },
                    {
                        "type": "command",
                        "statusMessage": "Loading session self-introduction policy…",
                        "timeout": 30,
                        "command": "php .claude/hooks/sessionstart_06_selfintro.php"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "End-stage documentation sweep (pattern docs, legends, guides, tests, temp files)…",
                        "timeout": 15,
                        "command": "php .claude/hooks/stop_docsync.php"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "Checking module pattern-doc has been read…",
                        "timeout": 15,
                        "command": "php .claude/hooks/pretooluse_pattern_doc_gate.php"
                    }
                ]
            },
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "Checking test-run discipline (no unscoped full-suite runs)…",
                        "timeout": 15,
                        "command": "php .claude/hooks/pretooluse_test_discipline_gate.php"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "Edit-state tracker (inert in subagent mode — unit-review subagent owns review; API only enrichment + end-stage dual review)…",
                        "timeout": 120,
                        "command": "php .claude/hooks/post_tool_review.php"
                    }
                ]
            },
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "statusMessage": "Recording pattern-doc read…",
                        "timeout": 15,
                        "command": "php .claude/hooks/posttooluse_pattern_doc_tracker.php"
                    }
                ]
            }
        ]
    }
}